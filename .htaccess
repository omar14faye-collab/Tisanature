# ═══════════════════════════════════════════════════════
#  TISANATURE — .htaccess racine  (projet3/)
# ═══════════════════════════════════════════════════════

# ── Bloquer accès direct aux dossiers sensibles ────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquer config/ et sql/ depuis le navigateur
    RewriteRule ^config/     - [F,L]
    RewriteRule ^sql/        - [F,L]

    # Bloquer les fichiers PHP de debug
    RewriteRule ^diagnostic  - [F,L]
    RewriteRule ^create_admin - [F,L]
</IfModule>

# ── Headers de sécurité ────────────────────────────────
<IfModule mod_headers.c>
    # Empêche le navigateur de deviner le type MIME
    Header set X-Content-Type-Options "nosniff"

    # Empêche l'intégration dans une iframe (clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Active le filtre XSS du navigateur
    Header set X-XSS-Protection "1; mode=block"

    # Ne pas envoyer le Referer sur les liens externes
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Interdire le chargement de ressources externes non autorisées
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:;"
</IfModule>

# ── Bloquer accès direct aux fichiers .sql et .env ────
<FilesMatch "\.(sql|env|log|sh|bak|git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Désactiver la liste des répertoires ───────────────
Options -Indexes

# ── Cacher la signature Apache ─────────────────────────
ServerSignature Off